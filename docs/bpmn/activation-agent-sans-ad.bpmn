      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="248" y="135" /><di:waypoint x="310" y="135" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="380" y="180" /><di:waypoint x="380" y="510" /></bpmndi:BPMNEdge>
