      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="600" y="135" /><di:waypoint x="680" y="135" /><di:waypoint x="680" y="280" /></bpmndi:BPMNEdge>
