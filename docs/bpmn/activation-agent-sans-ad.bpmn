      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="980" y="580" /><di:waypoint x="980" y="685" /><di:waypoint x="1112" y="685" /><bpmndi:BPMNLabel><dc:Bounds x="988" y="586" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1200" y="325" /><di:waypoint x="1280" y="325" /><di:waypoint x="1280" y="510" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1350" y="555" /><di:waypoint x="1430" y="555" /><di:waypoint x="1430" y="785" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1500" y="830" /><di:waypoint x="1580" y="830" /><di:waypoint x="1580" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1650" y="325" /><di:waypoint x="1730" y="325" /><di:waypoint x="1730" y="510" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1800" y="555" /><di:waypoint x="1855" y="555" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1905" y="555" /><di:waypoint x="2030" y="555" /><di:waypoint x="2030" y="370" /><bpmndi:BPMNLabel><dc:Bounds x="1911" y="535" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1880" y="530" /><di:waypoint x="1880" y="259" /><di:waypoint x="1580" y="259" /><di:waypoint x="1580" y="280" /><bpmndi:BPMNLabel><dc:Bounds x="1590" y="243" width="112" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
