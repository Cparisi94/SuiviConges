# À copier en .env (non versionné) sur l'hôte Docker de la DMZ.
# Adresse du backend Suivi des congés sur le LAN (obligatoire) : la seule ouverture du pare-feu DMZ -> LAN.
MOBILE_BACKEND_HOST=
MOBILE_BACKEND_PORT=8110
# Port publié du conteneur (le reverse-proxy HTTPS de la Ville pointe dessus).
MOBILE_DMZ_PORT=8113
