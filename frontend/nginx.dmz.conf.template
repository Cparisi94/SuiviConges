# Configuration nginx du frontend DMZ (port 8112). Variables ${...} remplacées par envsubst au démarrage.
# Même application que le frontend interne, avec une surface réduite : seules les routes utiles aux agents
# et valideurs sont relayées vers le backend (zone interne). Le HTTPS est terminé par le reverse-proxy
# de la Ville placé devant ce conteneur.
#
# Routes volontairement NON relayées depuis la DMZ (réponse 404) :
#   /api/v1/*             API des applications internes + administration des clés API
#   /api-docs             documentation Swagger
#   /api/status           état détaillé de l'application (supervision interne uniquement)
#   /api/admin/act-as     « se connecter en tant que » (usurpation) : réservé au réseau interne
# À adapter si la DRH décide d'ouvrir une de ces fonctions depuis l'extérieur.

map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Plus strict que le frontend interne : 5 tentatives de connexion par minute et par adresse.
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    client_max_body_size 6m;   # pièces jointes : 5 Mo maximum côté application

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Routes réservées au réseau interne : invisibles depuis la DMZ.
    location ~ ^/(api/v1/|api-docs|api/status|api/admin/act-as) {
        return 404;
    }

    location = /api/auth/login {
        limit_req zone=login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
        proxy_read_timeout 60s;
    }

    # Application (page unique) : jamais mise en cache, politique de contenu stricte.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
