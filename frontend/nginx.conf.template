# Configuration nginx du frontend (variables ${...} remplacées par envsubst au démarrage du conteneur).
# Le HTTPS est terminé par le reverse-proxy de la Ville placé devant ce conteneur.

# Protocole vu par le backend : celui transmis par le proxy amont, sinon celui de cette connexion.
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# /mobile/ : TEST SEULEMENT, sur le réseau interne. En production, la version mobile n'est exposée que par le frontend de la DMZ (conges-mobile-dmz).
# Actif uniquement si MOBILE_TEST=1 ET si le nom d'hôte demandé se termine par .ivry.local ; dans tous les autres cas, /mobile/ répond 404.
map "${MOBILE_TEST}:$host" $mobile_test {
    default 0;
    "~^1:.+\.ivry\.local$" 1;
}

# Freine les tentatives de connexion répétées (en plus de la limite applicative).
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=act:10m rate=12r/m;      # activation d'un compte sans AD (4 étapes, SMS) : plus strict que l'API courante

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    client_max_body_size 6m;   # pièces jointes : 5 Mo maximum côté application

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
        proxy_read_timeout 60s;
    }

    # Version mobile (TEST SEULEMENT, voir la carte $mobile_test en tête de fichier) : le backend MOBILE (conteneur backend-mobile, liste blanche
    # de routes) sert la page et son API sous /mobile/.
    # Le préfixe est retiré (/mobile/api/me -> /api/me). Le cookie de session mobile est distinct de celui de l'application.
    # Adresse résolue à l'usage (resolver Docker) : nginx démarre même si le conteneur mobile est arrêté (502 jusqu'à son retour).
    location = /mobile {
        if ($mobile_test = 0) { return 404; }
        return 301 /mobile/;
    }
    location = /mobile/api/auth/login {
        if ($mobile_test = 0) { return 404; }
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $mobile_up ${MOBILE_BACKEND_URL};
        rewrite ^/mobile/(.*)$ /$1 break;
        proxy_pass $mobile_up;
        include /etc/nginx/proxy_params_conges;
    }
    location ^~ /mobile/api/activation/ {
        if ($mobile_test = 0) { return 404; }
        limit_req zone=act burst=6 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $mobile_up ${MOBILE_BACKEND_URL};
        rewrite ^/mobile/(.*)$ /$1 break;
        proxy_pass $mobile_up;
        include /etc/nginx/proxy_params_conges;
    }
    location ^~ /mobile/ {
        if ($mobile_test = 0) { return 404; }
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $mobile_up ${MOBILE_BACKEND_URL};
        rewrite ^/mobile/(.*)$ /$1 break;
        proxy_pass $mobile_up;
        include /etc/nginx/proxy_params_conges;
        proxy_set_header X-Scope "";
        proxy_read_timeout 60s;
    }

    # Documentation Swagger (page et ressources)
    location /api-docs {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
    }

    # Application (page unique) : jamais mise en cache, politique de contenu stricte.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
