# =============================================================================
# SUIVI DES CONGÉS — configuration
# Modèle : copier en « .env » (cp .env.example .env) puis renseigner les valeurs. Le fichier .env n'est pas versionné.
# Format : une variable par ligne, « CLÉ=valeur ». Les commentaires sont sur leurs propres lignes
# (docker-compose ne gère pas les commentaires en fin de ligne). Une ligne commentée (#) prend sa valeur par défaut.
# =============================================================================


# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------

# Clé secrète qui signe les sessions (OBLIGATOIRE avec Docker). Générer : openssl rand -hex 32
# Changer cette clé déconnecte tous les utilisateurs.
CONGES_SECRET_KEY=

# Mode de connexion : « local » (mots de passe de l'application) ou « ad » (Active Directory via l'API centrale).
# En mode ad, les administrateurs gardent aussi un mot de passe local de secours.
CONGES_AUTH_MODE=local

# Adresse publique de l'application, sans « / » final : sert aux liens des e-mails.
# CONGES_BASE_URL=https://conges.example.fr

# Mot de passe du compte « admin » créé au tout premier démarrage sur un schéma vide
# (aléatoire, affiché une seule fois dans les journaux, si vide).
# CONGES_INITIAL_ADMIN_PASSWORD=

# Durée de validité d'une session, en heures.
# CONGES_SESSION_HOURS=10

# 1 quand l'application est servie en HTTPS (valeur par défaut avec Docker). Mettre 0 pour un essai en HTTP simple,
# sinon la connexion échoue (le cookie n'est pas renvoyé).
# CONGES_COOKIE_SECURE=1

# Nombre de reverse-proxys de confiance devant l'application : 1 avec le nginx du frontend seul (valeur par défaut avec Docker),
# 2 si le proxy de la Ville s'ajoute devant. Détermine l'adresse IP vue (journal des connexions, restrictions des clés API).
# CONGES_PROXY_HOPS=1

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules (vide = aucune).
# CONGES_CORS_ORIGINS=

# Requêtes par minute et par clé API.
# CONGES_API_RATE_LIMIT=120

# Échecs de connexion tolérés par adresse IP sur 15 minutes.
# CONGES_LOGIN_MAX_FAILURES=8

# 1 pour désactiver les relances automatiques et la purge des journaux (tests).
# CONGES_DISABLE_REMINDERS=0

# Poste de développement seulement : adresse d'écoute du serveur (0.0.0.0 pour tout le réseau).
# CONGES_HOST=127.0.0.1

# Poste de développement seulement : port du serveur.
# CONGES_PORT=8110

# ----------------------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL (schéma dédié de la Ville)
# ----------------------------------------------------------------------------

# Serveur PostgreSQL (voir l'équipe DSI).
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin

# Compte de connexion : idéalement un rôle limité au schéma « conges » (voir l'équipe DSI).
POSTGRES_USER=
POSTGRES_PASSWORD=

# Schéma de l'application (créé et migré automatiquement au démarrage).
CONGES_PG_SCHEMA=conges

# Nombre maximal de connexions simultanées à la base.
# CONGES_PG_POOL_MAX=10

# ----------------------------------------------------------------------------
# API CENTRALE DE LA VILLE (APM) : connexion AD et e-mails
# ----------------------------------------------------------------------------

# Adresse de l'API centrale.
APM_API_URL=https://api.ivry.local

# Clé X-API-KEY propre à cette application (permissions ad_auth, ad_search, mail_send). Jamais côté navigateur, jamais dans Git.
APM_API_KEY=

# 1 = accepter un certificat auto-signé de l'API centrale. À ÉVITER en production : préférer VILLE_CA_FILE.
VILLE_ALLOW_SELF_SIGNED_CERTS=0

# Fichier de l'autorité de certification de la Ville (vérification TLS vers l'API centrale).
# VILLE_CA_FILE=/chemin/autorite-ville.pem

# ----------------------------------------------------------------------------
# E-MAILS
# ----------------------------------------------------------------------------

# L'envoi des e-mails s'ACTIVE dans l'application (Paramétrage > E-mails), pas ici. Valeurs initiales du pied de page,
# modifiables ensuite dans l'application : lignes 1 à 3 et couleur.
# CONGES_MAIL_FOOTER1=Ville d'Ivry-sur-Seine
# CONGES_MAIL_FOOTER2=Direction des Ressources Humaines
# CONGES_MAIL_FOOTER3=
# CONGES_MAIL_FOOTER_COLOR=#0055A4

# ----------------------------------------------------------------------------
# API SEDIT RH (agents et organisation, lecture seule)
# ----------------------------------------------------------------------------

# En développement : API locale lancée depuis C:\dev\api-apps\sedit-rh\backend (npm run dev:local).
# Sur un serveur Docker, « localhost » désigne le conteneur : mettre l'adresse réelle de l'API.
SEDITRH_API_URL=http://localhost:3440

# Clé « srh_live_… » créée dans l'administration de l'API Sedit RH (droits agents:read et organisation:read).
SEDITRH_API_KEY=

# ----------------------------------------------------------------------------
# API HUB DSI (non utilisée pour l'instant)
# ----------------------------------------------------------------------------

# Provisoire : http://10.103.130.106:3001 ; cible : https://dsihub.ivry.local
# HUBDSI_API_URL=

# Clé « dsk_… » fournie par l'administrateur du Hub DSI.
# HUBDSI_API_KEY=

# ----------------------------------------------------------------------------
# DOCKER : PORTS ET FRONTEND (docker-compose)
# ----------------------------------------------------------------------------

# Port du frontend interne. Ports prévus : backend 8110, frontend interne 8111, frontend DMZ 8112.
FRONT_PORT=8111

# Port du backend sur la machine.
BACK_PORT=8110

# Interface d'écoute du backend : 127.0.0.1 = machine locale seulement ; à ouvrir (par pare-feu) quand le frontend DMZ doit le joindre.
BACK_BIND=127.0.0.1

# Port du frontend de la DMZ (docker-compose.dmz.yml).
DMZ_FRONT_PORT=8112

# Adresse du backend vue par le frontend ; pour la DMZ : adresse interne du backend, ex. http://10.0.0.5:8110
# BACKEND_URL=http://backend:8110

# Sous-réseau Docker de l'application (fixe, pour ne pas dépendre des plages automatiques du serveur, parfois épuisées).
# Ne doit chevaucher aucun réseau existant : voir « docker network ls » et « docker network inspect ».
# CONGES_SUBNET=10.77.110.0/24

# Sous-réseau Docker du frontend DMZ (docker-compose.dmz.yml).
# CONGES_DMZ_SUBNET=10.77.112.0/24

# ----------------------------------------------------------------------------
# STOCKAGE
# ----------------------------------------------------------------------------

# Dossier des pièces jointes (Docker : /data/uploads/requests, dans le volume conges_data).
# CONGES_UPLOAD_DIR=uploads/requests

# Ancienne base SQLite, lue seulement par migrate_sqlite_to_pg.py.
# CONGES_SQLITE_PATH=suivi-conges.db
