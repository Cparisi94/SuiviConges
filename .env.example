# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs.
# Toute variable absente prend la valeur par défaut indiquée.

# --- Application ---
# 0.0.0.0 pour écouter sur le réseau
CONGES_HOST=127.0.0.1
CONGES_PORT=8110
# secret de signature des sessions (32 caractères aléatoires minimum)
CONGES_SECRET_KEY=
# 1 dès que l'application est servie en HTTPS
CONGES_COOKIE_SECURE=0
# durée de validité d'une session
CONGES_SESSION_HOURS=10
# nombre de reverse-proxys de confiance devant l'app (1 en DMZ/Nginx)
CONGES_PROXY_HOPS=0
# origines autorisées (séparées par des virgules) ; vide = aucune
CONGES_CORS_ORIGINS=
# requêtes par minute et par clé API
CONGES_API_RATE_LIMIT=120
# échecs de connexion tolérés par IP sur 15 minutes
CONGES_LOGIN_MAX_FAILURES=8
# mot de passe du compte admin créé au 1er démarrage (aléatoire si vide)
CONGES_INITIAL_ADMIN_PASSWORD=
# adresse publique de l'application (liens dans les mails)
CONGES_BASE_URL=
# local = mots de passe de l'application ; ad = Active Directory via l'APM
CONGES_AUTH_MODE=local

# --- Ports Docker : backend 8110, frontend 8111, futur frontend DMZ 8112 ---
BACK_PORT=8110
# 127.0.0.1 tant qu'aucun frontend distant (DMZ) ne doit joindre le backend
BACK_BIND=127.0.0.1
FRONT_PORT=8111
DMZ_FRONT_PORT=8112

# --- Stockage ---
CONGES_UPLOAD_DIR=uploads/requests
CONGES_DISABLE_REMINDERS=0
# ancienne base, lue seulement par migrate_sqlite_to_pg.py
CONGES_SQLITE_PATH=suivi-conges.db

# --- Base de données PostgreSQL (Ville) ---
# schéma dédié à l'application
CONGES_PG_SCHEMA=conges
CONGES_PG_POOL_MAX=10
# voir équipe DSI
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
# voir équipe DSI
POSTGRES_USER=
# voir équipe DSI
POSTGRES_PASSWORD=

# --- API centrale APM (AD, mail) --- permissions de la clé : ad_auth, mail_send
APM_API_URL=https://api.ivry.local
# clé X-API-KEY fournie par l'admin APM, propre à cette application
APM_API_KEY=
# autorité de certification de la Ville (fichier .pem), si besoin
VILLE_CA_FILE=
# 1 = accepter un certificat auto-signé (à éviter en production)
VILLE_ALLOW_SELF_SIGNED_CERTS=0

# --- Mails ---
# L'envoi des e-mails s'active dans l'application (Paramétrage > E-mails), pas ici.
# Valeurs initiales du pied de page (modifiables ensuite dans l'application) :
CONGES_MAIL_FOOTER1=Ville d'Ivry-sur-Seine
CONGES_MAIL_FOOTER2=Direction des Ressources Humaines
CONGES_MAIL_FOOTER3=
CONGES_MAIL_FOOTER_COLOR=#0055A4

# --- API métier Hub DSI ---
# provisoire : http://10.103.130.106:3001, cible https://dsihub.ivry.local
HUBDSI_API_URL=
# clé dsk_... fournie par l'admin Hub DSI
HUBDSI_API_KEY=

# --- API Sedit RH (agents, organisation ; lecture seule) ---
# En développement : API locale lancée depuis C:\dev\api-apps\sedit-rh\backend (npm run dev:local), port 3440.
SEDITRH_API_URL=http://localhost:3440
# Clé « srh_live_… » créée dans l'administration de l'API Sedit RH (droits agents:read et organisation:read)
SEDITRH_API_KEY=
