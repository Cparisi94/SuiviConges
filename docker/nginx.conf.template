# Configuration nginx du frontend (variables ${...} remplacées par envsubst au démarrage du conteneur).
# Le HTTPS est terminé par le reverse-proxy de la Ville placé devant ce conteneur.

# Protocole vu par le backend : celui transmis par le proxy amont, sinon celui de cette connexion.
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Freine les tentatives de connexion répétées (en plus de la limite applicative).
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    client_max_body_size 6m;   # pièces jointes : 5 Mo maximum côté application

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
        proxy_read_timeout 60s;
    }

    # Documentation Swagger (page et ressources)
    location /api-docs {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_conges;
    }

    # Application (page unique) : jamais mise en cache, politique de contenu stricte.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
